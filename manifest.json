{
  "manifest_version": 3,
  "name": "Course Video Downloader",
  "version": "1.0.0",
  "description": "Detects videos on the current page and downloads them with progress shown in the popup.",
  "permissions": ["webRequest", "downloads", "downloads.open", "storage", "tabs", "offscreen", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Course Video Downloader", "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ]
}
